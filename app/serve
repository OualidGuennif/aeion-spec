#!/usr/bin/env bash
# Spec: knowledge/components/aeion-engine.md
# Launch aeion-spec backend (Elysia API :4171) + Next.js Studio (:4170).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
API_PORT="${AEION_API_PORT:-4171}"
WEB_PORT="${AEION_PORT:-4170}"

cleanup() {
  if [[ -n "${API_PID:-}" ]]; then kill "$API_PID" 2>/dev/null || true; fi
  if [[ -n "${WEB_PID:-}" ]]; then kill "$WEB_PID" 2>/dev/null || true; fi
}
trap cleanup EXIT INT TERM

echo "[aeion-spec] Starting Elysia API on http://127.0.0.1:${API_PORT} ..."
(cd "$ROOT" && AEION_API_PORT="$API_PORT" bun run packages/server/src/index.ts) &
API_PID=$!

for _ in $(seq 1 40); do
  if curl -fsS "http://127.0.0.1:${API_PORT}/api/health" >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done

echo "[aeion-spec] Starting Next.js UI on http://127.0.0.1:${WEB_PORT} ..."
if [[ "${AEION_DEV:-0}" == "1" ]] || [[ ! -d "$ROOT/packages/web/.next" ]]; then
  (cd "$ROOT/packages/web" && AEION_INTERNAL_API_ORIGIN="http://127.0.0.1:${API_PORT}" bunx next dev -H 127.0.0.1 -p "$WEB_PORT") &
else
  (cd "$ROOT/packages/web" && AEION_INTERNAL_API_ORIGIN="http://127.0.0.1:${API_PORT}" bunx next start -H 127.0.0.1 -p "$WEB_PORT") &
fi
WEB_PID=$!

wait "$API_PID" "$WEB_PID"
